---
import type { Dates } from "../models/memories.model";

const { memory } = Astro.props;
---

<!-- Script --><!-- Componente -->
<div class="pb-4">
	<p class="scroll-item">{memory.month.number}</p>
	<hr class="border-5 border-primary w-full" />
	<div class="flex gap-10">
		<p class="w-40">{memory.month.label}</p>
		<div class="gap-5 flex overflow-x-auto scroll-smooth scroll-none">
			{
				memory.dates.map((item: Dates, index: number) => (
					<div
						class="memory-item cursor-pointer"
						data-index={index}
						id="abrir"
						data-memory={JSON.stringify(item)}
						style="min-width: 200px;">
						<p>{item.day}</p>
						<img src={item.img} alt={item.title} width="200px" />
					</div>
				))
			}
		</div>
	</div>
</div>

<!-- Modal -->
<div
	class="relative z-10 duration-300 hidden ease-in-out transition-opacity"
	aria-labelledby="modal-title"
	role="dialog"
	id="modal"
	aria-modal="true">
	<div
		class="fixed inset-0 bg-black opacity-50 transition-opacity"
		aria-hidden="true">
	</div>

	<div class="fixed inset-0 z-10 w-screen overflow-y-auto">
		<div
			class="flex min-h-full items-end justify-center p-5 text-center sm:items-center">
			<div
				class="relative transform overflow-hidden p-5 w-2/3 bg-background border border-primary text-left">
				<div class="flex gap-3">
					<img
						id="modal-img"
						width="30%"
						class="object-fill"
						src="https://placehold.jp/150x200.png"
					/>
					<div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
						<p id="modal-day"></p>
						<h2 id="modal-title" class="text-xl font-bold"></h2>
						<p id="modal-description"></p>
					</div>
				</div>
				<div
					class="bg-background px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
					<button
						id="close-modal"
						type="button"
						class="mt-3 inline-flex w-full justify-center bg-primary text-background px-3 py-2 font-semibold hover:bg-background border border-primary hover:text-primary m:mt-0 sm:w-auto">
						Hermoso recuerdo
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const modal = document.getElementById("modal");
		const memoryItems = document.querySelectorAll(".memory-item");
		const closeModalBtn = document.getElementById("close-modal");

		const modalImg = document.getElementById("modal-img");
		const day = document.getElementById("modal-day");
		const title = document.getElementById("modal-title");
		const description = document.getElementById("modal-description");

		memoryItems.forEach((item) => {
			if (item)
				item.addEventListener("click", () => {
					// Obtener los datos del item seleccionado
					const memoryItem = JSON.parse(
						item ? item.getAttribute("data-memory") || "{}" : "{}"
					);

					// Obtener los datos de memoryItem
					const imgSrc = memoryItem.img; // URL de la imagen
					const itemDay = memoryItem.day; // Día del recuerdo
					const itemTitle = memoryItem.title; // Título del recuerdo
					const itemDescription = memoryItem.description; // Descripción del recuerdo

					if (modalImg && day && title && description) {
						modalImg.setAttribute("src", imgSrc); // Establecer la imagen
						day.textContent = itemDay; // Establecer el día
						title.textContent = itemTitle; // Establecer el título
						description.textContent = itemDescription; // Establecer la descripción
					}
					// Mostrar el modal
					if (modal) modal.style.display = "flex";
				});
		});

		closeModalBtn?.addEventListener("click", () => {
			if (modal) modal.style.display = "none"; // Cerrar el modal
		});
	});
</script>
