---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import PicturesRow from "../components/PicturesRow.astro";
import { TITLE, SITE_DESCRIPTION } from "../consts";

import type { Memory } from "../models/memories.model";
import { getDailyMemories } from "../services/service";

const memories = await getDailyMemories();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			{memories.map((memorie: Memory) => <PicturesRow memory={memorie} />)}
		</main>
	</body>
</html>
